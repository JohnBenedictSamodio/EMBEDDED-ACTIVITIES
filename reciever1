// ============================================================
// ESP32 8-BIT ASCII PARALLEL DATA TRANSMISSION
// STUDENT B - RECEIVER
// ============================================================
//
// DATA PINS:
//
// Bit 0 -> GPIO 4
// Bit 1 -> GPIO 5
// Bit 2 -> GPIO 18
// Bit 3 -> GPIO 19
// Bit 4 -> GPIO 21
// Bit 5 -> GPIO 22
// Bit 6 -> GPIO 23
// Bit 7 -> GPIO 25
//
// SPECIAL CODES:
//
// 11111111 = START
// 00000000 = GAP
// 11111110 = END
//
// START, GAP, and END are handled internally
// and are NOT displayed.
// ============================================================


const int DATA_PINS[8] = {
  4, 5, 18, 19, 21, 22, 23, 25
};


// ============================================================
// SPECIAL CODES
// ============================================================

const byte START_CODE = 0xFF;   // 11111111
const byte GAP_CODE   = 0x00;   // 00000000
const byte END_CODE   = 0xFE;   // 11111110


// ============================================================
// RECEIVER STATES
// ============================================================

enum ReceiverState {

  WAITING_FOR_START,

  WAITING_FOR_CHARACTER,

  WAITING_FOR_GAP
};


ReceiverState state = WAITING_FOR_START;


// ============================================================
// RECEIVED WORD
// ============================================================

String receivedWord = "";


// ============================================================
// READ 8 GPIO INPUTS
// ============================================================

byte readByte() {

  byte value = 0;

  for (int bit = 0; bit < 8; bit++) {

    int bitValue = digitalRead(DATA_PINS[bit]);

    value |= ((byte)bitValue << bit);
  }

  return value;
}


// ============================================================
// PRINT BINARY VALUE
// ============================================================

void printBinary(byte value) {

  for (int bit = 7; bit >= 0; bit--) {

    Serial.print((value >> bit) & 1);
  }
}


// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);


  // Configure the eight GPIO pins as INPUT.
  for (int bit = 0; bit < 8; bit++) {

    pinMode(DATA_PINS[bit], INPUT);
  }


  Serial.println();
  Serial.println("Receiver ready.");
  Serial.println();
}


// ============================================================
// MAIN LOOP
// ============================================================

void loop() {

  // Read all eight parallel data lines.
  byte value = readByte();


  // ==========================================================
  // WAITING FOR A NEW MESSAGE
  // ==========================================================

  if (state == WAITING_FOR_START) {

    // Wait for START = 11111111.

    if (value == START_CODE) {

      // Clear the previous message.
      receivedWord = "";

      // Start receiving characters.
      state = WAITING_FOR_CHARACTER;
    }

    return;
  }


  // ==========================================================
  // WAITING FOR CHARACTER
  // ==========================================================

  if (state == WAITING_FOR_CHARACTER) {


    // --------------------------------------------------------
    // Ignore GAP.
    // --------------------------------------------------------

    if (value == GAP_CODE) {

      return;
    }


    // --------------------------------------------------------
    // END OF MESSAGE
    // --------------------------------------------------------

    if (value == END_CODE) {

      Serial.println();

      Serial.print("Received: ");
      Serial.println(receivedWord);

      Serial.println();


      // Wait for another new message.
      state = WAITING_FOR_START;

      return;
    }


    // --------------------------------------------------------
    // Ignore unexpected START.
    // --------------------------------------------------------

    if (value == START_CODE) {

      return;
    }


    // --------------------------------------------------------
    // Printable ASCII character
    // --------------------------------------------------------

    if (value >= 32 && value <= 126) {

      char character = (char)value;


      // Add character to the word.
      receivedWord += character;


      // ------------------------------------------------------
      // DISPLAY CHARACTER AND BINARY
      // ------------------------------------------------------

      Serial.print(character);

      Serial.print("  ");

      printBinary(value);

      Serial.println();


      // Wait for the GAP before receiving the next character.
      state = WAITING_FOR_GAP;


      return;
    }


    return;
  }


  // ==========================================================
  // WAITING FOR GAP
  // ==========================================================

  if (state == WAITING_FOR_GAP) {

    // Wait until all eight lines become LOW.

    if (value == GAP_CODE) {

      // The gap has been detected.
      // Now look for the next character.

      state = WAITING_FOR_CHARACTER;
    }

    return;
  }
}
