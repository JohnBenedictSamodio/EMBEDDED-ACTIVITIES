// ============================================================
// LABORATORY 1
// ESP32 8-BIT ASCII PARALLEL DATA TRANSMISSION
//
// STUDENT B - RECEIVER
// ============================================================
//
// 8 DATA LINES:
//
// Bit 0 -> GPIO 4
// Bit 1 -> GPIO 5
// Bit 2 -> GPIO 18
// Bit 3 -> GPIO 19
// Bit 4 -> GPIO 21
// Bit 5 -> GPIO 22
// Bit 6 -> GPIO 23
// Bit 7 -> GPIO 25
//
// SPECIAL CODES:
//
// 11111111 = START
// 00000000 = GAP
// 11111110 = END
//
// START, GAP, and END are handled internally.
// They are NOT displayed in the Serial Monitor.
// ============================================================


// ============================================================
// GPIO PINS
// ============================================================

const int DATA_PINS[8] = {
  4, 5, 18, 19, 21, 22, 23, 25
};


// ============================================================
// SPECIAL CODES
// ============================================================

const byte START_CODE = 0xFF;   // 11111111

const byte GAP_CODE = 0x00;     // 00000000

const byte END_CODE = 0xFE;     // 11111110


// ============================================================
// RECEIVER STATES
// ============================================================

enum ReceiverState {

  WAITING_FOR_START,

  WAITING_FOR_CHARACTER,

  WAITING_FOR_GAP
};


ReceiverState state = WAITING_FOR_START;


// ============================================================
// RECEIVED WORD
// ============================================================

String receivedWord = "";


// ============================================================
// READ THE 8 GPIO INPUTS
// ============================================================

byte readByte() {

  byte value = 0;


  for (int bit = 0; bit < 8; bit++) {

    int bitValue = digitalRead(DATA_PINS[bit]);

    value |= ((byte)bitValue << bit);
  }


  return value;
}


// ============================================================
// STABLE READ
// ============================================================
//
// The Receiver reads the eight GPIO pins several times.
//
// If all readings agree, the byte is considered stable.
//
// This helps prevent a single unstable reading from becoming
// a wrong character.
// ============================================================

bool readStableByte(byte &result) {

  const int REQUIRED_READS = 5;

  byte firstValue = readByte();


  // Read the same byte several times.
  for (int i = 1; i < REQUIRED_READS; i++) {

    delay(2);

    byte currentValue = readByte();


    // If the value changes, it is not stable.
    if (currentValue != firstValue) {

      return false;
    }
  }


  result = firstValue;

  return true;
}


// ============================================================
// PRINT 8-BIT BINARY
// ============================================================

void printBinary(byte value) {

  for (int bit = 7; bit >= 0; bit--) {

    Serial.print((value >> bit) & 1);
  }
}


// ============================================================
// WAIT FOR A STABLE VALUE
// ============================================================

byte waitForStableValue() {

  byte value;

  while (true) {

    if (readStableByte(value)) {

      return value;
    }

    delay(5);
  }
}


// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);


  // Configure all eight GPIO pins as INPUT.
  for (int bit = 0; bit < 8; bit++) {

    pinMode(DATA_PINS[bit], INPUT);
  }


  Serial.println();

  Serial.println("Receiver ready.");

  Serial.println();
}


// ============================================================
// MAIN LOOP
// ============================================================

void loop() {

  byte value;


  // ==========================================================
  // STATE 1
  // WAITING FOR START
  // ==========================================================

  if (state == WAITING_FOR_START) {

    value = readByte();


    // Look for:
    //
    // 11111111
    //
    // This indicates a new message.

    if (value == START_CODE) {

      // Clear previous message.
      receivedWord = "";


      // Move to character receiving state.
      state = WAITING_FOR_CHARACTER;
    }


    return;
  }


  // ==========================================================
  // STATE 2
  // WAITING FOR CHARACTER
  // ==========================================================

  if (state == WAITING_FOR_CHARACTER) {

    value = readByte();


    // --------------------------------------------------------
    // Ignore GAP.
    // --------------------------------------------------------

    if (value == GAP_CODE) {

      return;
    }


    // --------------------------------------------------------
    // END OF MESSAGE
    // --------------------------------------------------------

    if (value == END_CODE) {

      Serial.println();

      Serial.print("Received: ");

      Serial.println(receivedWord);

      Serial.println();


      // Wait for a completely new message.
      state = WAITING_FOR_START;


      return;
    }


    // --------------------------------------------------------
    // Ignore START.
    // --------------------------------------------------------

    if (value == START_CODE) {

      return;
    }


    // --------------------------------------------------------
    // Check for printable ASCII.
    // --------------------------------------------------------

    if (value >= 32 && value <= 126) {


      // ------------------------------------------------------
      // Verify that the byte is stable.
      // ------------------------------------------------------

      byte stableValue;

      if (!readStableByte(stableValue)) {

        return;
      }


      // Make sure the stable value is still printable ASCII.
      if (stableValue < 32 || stableValue > 126) {

        return;
      }


      char character = (char)stableValue;


      // ------------------------------------------------------
      // Add character to the received word.
      // ------------------------------------------------------

      receivedWord += character;


      // ------------------------------------------------------
      // DISPLAY CHARACTER + BINARY
      // ------------------------------------------------------

      Serial.print(character);

      Serial.print("  ");

      printBinary(stableValue);

      Serial.println();


      // ------------------------------------------------------
      // Wait for GAP before accepting another character.
      // ------------------------------------------------------

      state = WAITING_FOR_GAP;


      return;
    }


    return;
  }


  // ==========================================================
  // STATE 3
  // WAITING FOR GAP
  // ==========================================================

  if (state == WAITING_FOR_GAP) {

    value = readByte();


    // Wait until all eight GPIO lines are LOW.

    if (value == GAP_CODE) {

      // GAP detected.

      // Now wait for the next character.
      state = WAITING_FOR_CHARACTER;
    }


    return;
  }
}
