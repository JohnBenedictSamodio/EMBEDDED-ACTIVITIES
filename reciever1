// ============================================================
// LABORATORY 1
// ESP32 8-BIT ASCII PARALLEL DATA TRANSMISSION
//
// STUDENT B - RECEIVER
// ============================================================
//
// GPIO 4  = Bit 0
// GPIO 5  = Bit 1
// GPIO 18 = Bit 2
// GPIO 19 = Bit 3
// GPIO 21 = Bit 4
// GPIO 22 = Bit 5
// GPIO 23 = Bit 6
// GPIO 25 = Bit 7
//
// ============================================================


// ============================================================
// DATA PINS
// ============================================================

const int DATA_PINS[8] = {
  4, 5, 18, 19, 21, 22, 23, 25
};


// ============================================================
// SPECIAL VALUES
// ============================================================

const byte START_CODE = 0xFF;
const byte GAP_CODE   = 0x00;
const byte END_CODE   = 0xFE;


// ============================================================
// RECEIVER STATES
// ============================================================

enum State {

  WAITING_FOR_START,

  WAITING_FOR_CHARACTER,

  WAITING_FOR_GAP
};


State currentState = WAITING_FOR_START;


// ============================================================
// MESSAGE STORAGE
// ============================================================

String receivedWord = "";


// ============================================================
// READ EIGHT GPIO PINS
// ============================================================

byte readByte() {

  byte value = 0;

  for (int bit = 0; bit < 8; bit++) {

    int bitValue = digitalRead(DATA_PINS[bit]);

    value |= ((byte)bitValue << bit);
  }

  return value;
}


// ============================================================
// PRINT BINARY
// ============================================================

void printBinary(byte value) {

  for (int bit = 7; bit >= 0; bit--) {

    Serial.print((value >> bit) & 1);
  }
}


// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);


  // Configure eight GPIO pins as INPUT.
  for (int bit = 0; bit < 8; bit++) {

    pinMode(DATA_PINS[bit], INPUT);
  }


  Serial.println();
  Serial.println("================================");
  Serial.println("ESP32 ASCII RECEIVER");
  Serial.println("================================");
  Serial.println("Ready.");
  Serial.println();
}


// ============================================================
// MAIN LOOP
// ============================================================

void loop() {

  byte value = readByte();


  // ==========================================================
  // WAIT FOR START
  // ==========================================================

  if (currentState == WAITING_FOR_START) {

    if (value == START_CODE) {

      // Start a new message.
      receivedWord = "";

      currentState = WAITING_FOR_CHARACTER;
    }

    return;
  }


  // ==========================================================
  // WAIT FOR CHARACTER
  // ==========================================================

  if (currentState == WAITING_FOR_CHARACTER) {


    // --------------------------------------------------------
    // Ignore GAP.
    // --------------------------------------------------------

    if (value == GAP_CODE) {

      return;
    }


    // --------------------------------------------------------
    // END OF MESSAGE.
    // --------------------------------------------------------

    if (value == END_CODE) {

      Serial.println();

      Serial.print("Received: ");

      Serial.println(receivedWord);

      Serial.println();


      // Wait for another START.
      currentState = WAITING_FOR_START;

      return;
    }


    // --------------------------------------------------------
    // Ignore START.
    // --------------------------------------------------------

    if (value == START_CODE) {

      return;
    }


    // --------------------------------------------------------
    // Check whether value is printable ASCII.
    // --------------------------------------------------------

    if (value >= 32 && value <= 126) {

      char character = (char)value;


      // Add character to message.
      receivedWord += character;


      // Display character.
      Serial.print(character);

      Serial.print("  ");

      printBinary(value);

      Serial.println();


      // Wait for GAP.
      currentState = WAITING_FOR_GAP;

      return;
    }


    return;
  }


  // ==========================================================
  // WAIT FOR GAP
  // ==========================================================

  if (currentState == WAITING_FOR_GAP) {

    // Wait until all eight data lines become LOW.

    if (value == GAP_CODE) {

      currentState = WAITING_FOR_CHARACTER;
    }

    return;
  }
}
