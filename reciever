// ============================================================
// LABORATORY 1
// ESP32 8-BIT ASCII PARALLEL DATA TRANSMISSION
//
// STUDENT B - RECEIVER
// ============================================================

const int DATA_PINS[8] = {
  4, 5, 18, 19, 21, 22, 23, 25
};

// ============================================================
// TIMING
// ============================================================

const unsigned long START_TIME = 3000;
const unsigned long DATA_TIME  = 2000;
const unsigned long GAP_TIME   = 1000;

// ============================================================
// RECEIVER STATES
// ============================================================

enum ReceiverState {
  WAITING_FOR_START,
  WAITING_FOR_DATA,
  WAITING_FOR_GAP,
  WAITING_FOR_NEW_MESSAGE
};

ReceiverState state = WAITING_FOR_START;

// ============================================================
// RECEIVED WORD
// ============================================================

String receivedWord = "";

// ============================================================
// READ THE 8 GPIO INPUTS
// ============================================================

byte readByte() {

  byte value = 0;

  for (int bit = 0; bit < 8; bit++) {

    int bitValue = digitalRead(DATA_PINS[bit]);

    value |= ((byte)bitValue << bit);
  }

  return value;
}

// ============================================================
// PRINT 8-BIT BINARY
// ============================================================

void printBinary(byte value) {

  for (int bit = 7; bit >= 0; bit--) {
    Serial.print((value >> bit) & 1);
  }
}

// ============================================================
// DISPLAY COMPLETE WORD
// ============================================================

void displayWord() {

  Serial.println();
  Serial.println("==========================================");
  Serial.println("MESSAGE COMPLETE");
  Serial.println("==========================================");

  Serial.print("RECEIVED WORD: ");
  Serial.println(receivedWord);

  Serial.println("==========================================");
  Serial.println();

  Serial.println("Waiting for a new message...");
  Serial.println();
}

// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);

  // Configure all 8 GPIO pins as INPUT.
  for (int bit = 0; bit < 8; bit++) {
    pinMode(DATA_PINS[bit], INPUT);
  }

  Serial.println();
  Serial.println("==========================================");
  Serial.println(" ESP32 8-BIT ASCII PARALLEL RECEIVER");
  Serial.println("==========================================");
  Serial.println();

  Serial.println("GPIO INPUTS:");
  Serial.println("Bit 0 -> GPIO 4");
  Serial.println("Bit 1 -> GPIO 5");
  Serial.println("Bit 2 -> GPIO 18");
  Serial.println("Bit 3 -> GPIO 19");
  Serial.println("Bit 4 -> GPIO 21");
  Serial.println("Bit 5 -> GPIO 22");
  Serial.println("Bit 6 -> GPIO 23");
  Serial.println("Bit 7 -> GPIO 25");

  Serial.println();
  Serial.println("Waiting for a new message...");
  Serial.println();
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop() {

  byte value = readByte();

  // ==========================================================
  // STATE 1
  // WAITING FOR START
  // ==========================================================

  if (state == WAITING_FOR_START) {

    // 11111111 = START
    if (value == 0xFF) {

      receivedWord = "";

      Serial.println();
      Serial.println("NEW MESSAGE DETECTED");
      Serial.println();

      state = WAITING_FOR_DATA;

      // Wait for sender's START period.
      delay(START_TIME + 100);

      return;
    }

    return;
  }

  // ==========================================================
  // STATE 2
  // WAITING FOR DATA
  // ==========================================================

  if (state == WAITING_FOR_DATA) {

    // 00000000 = gap
    if (value == 0x00) {
      return;
    }

    // Ignore START signal.
    if (value == 0xFF) {
      return;
    }

    // Printable ASCII characters.
    if (value >= 32 && value <= 126) {

      char character = (char)value;

      // Add character to the word.
      receivedWord += character;

      Serial.print("Received: ");
      Serial.println(character);

      state = WAITING_FOR_GAP;

      // Wait for character display period.
      delay(DATA_TIME + 100);

      return;
    }

    return;
  }

  // ==========================================================
  // STATE 3
  // WAITING FOR GAP
  // ==========================================================

  if (state == WAITING_FOR_GAP) {

    if (value == 0x00) {

      // Wait for the character gap.
      delay(GAP_TIME + 100);

      byte nextValue = readByte();

      // ------------------------------------------------------
      // MESSAGE IS COMPLETE
      // ------------------------------------------------------

      if (nextValue == 0x00) {

        displayWord();

        // Do not display the word again.
        // Wait for a completely new START signal.
        state = WAITING_FOR_NEW_MESSAGE;

        return;
      }

      // ------------------------------------------------------
      // NEXT CHARACTER
      // ------------------------------------------------------

      if (nextValue >= 32 && nextValue <= 126) {

        char character = (char)nextValue;

        receivedWord += character;

        Serial.print("Received: ");
        Serial.println(character);

        state = WAITING_FOR_GAP;

        delay(DATA_TIME + 100);

        return;
      }

      return;
    }
  }

  // ==========================================================
  // STATE 4
  // WAITING FOR NEW MESSAGE
  // ==========================================================

  if (state == WAITING_FOR_NEW_MESSAGE) {

    // Wait here until a NEW START signal appears.
    if (value == 0xFF) {

      receivedWord = "";

      Serial.println();
      Serial.println("NEW MESSAGE DETECTED");
      Serial.println();

      state = WAITING_FOR_DATA;

      delay(START_TIME + 100);

      return;
    }

    return;
  }
}
