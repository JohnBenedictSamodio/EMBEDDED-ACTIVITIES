// ============================================================
// LABORATORY 1
// ESP32 8-BIT ASCII PARALLEL DATA TRANSMISSION
//
// STUDENT B - RECEIVER
// ============================================================

const int DATA_PINS[8] = {
  4, 5, 18, 19, 21, 22, 23, 25
};


// ============================================================
// TIMING
// ============================================================

const unsigned long START_TIME = 3000;
const unsigned long DATA_TIME  = 2000;
const unsigned long GAP_TIME   = 1000;


// ============================================================
// RECEIVER STATES
// ============================================================

enum ReceiverState {
  WAITING_FOR_START,
  WAITING_FOR_DATA,
  WAITING_FOR_GAP,
  WAITING_FOR_NEW_MESSAGE
};

ReceiverState state = WAITING_FOR_START;


// ============================================================
// RECEIVED WORD
// ============================================================

String receivedWord = "";


// ============================================================
// READ THE 8 GPIO INPUTS
// ============================================================

byte readByte() {

  byte value = 0;

  for (int bit = 0; bit < 8; bit++) {

    int bitValue = digitalRead(DATA_PINS[bit]);

    value |= ((byte)bitValue << bit);
  }

  return value;
}


// ============================================================
// PRINT 8-BIT BINARY
// ============================================================

void printBinary(byte value) {

  for (int bit = 7; bit >= 0; bit--) {

    Serial.print((value >> bit) & 1);
  }
}


// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);

  // Configure all 8 GPIO pins as INPUT.
  for (int bit = 0; bit < 8; bit++) {

    pinMode(DATA_PINS[bit], INPUT);
  }


  Serial.println();
  Serial.println("==========================================");
  Serial.println(" ESP32 8-BIT ASCII PARALLEL RECEIVER");
  Serial.println("==========================================");
  Serial.println();

  Serial.println("GPIO INPUTS:");
  Serial.println("Bit 0 -> GPIO 4");
  Serial.println("Bit 1 -> GPIO 5");
  Serial.println("Bit 2 -> GPIO 18");
  Serial.println("Bit 3 -> GPIO 19");
  Serial.println("Bit 4 -> GPIO 21");
  Serial.println("Bit 5 -> GPIO 22");
  Serial.println("Bit 6 -> GPIO 23");
  Serial.println("Bit 7 -> GPIO 25");

  Serial.println();
  Serial.println("Waiting for a new message...");
  Serial.println();
}


// ============================================================
// MAIN LOOP
// ============================================================

void loop() {

  byte value = readByte();


  // ==========================================================
  // STATE 1
  // WAITING FOR START
  // ==========================================================

  if (state == WAITING_FOR_START) {

    // 11111111 = START
    if (value == 0xFF) {

      // Clear previous message.
      receivedWord = "";


      Serial.println();
      Serial.println("==========================================");
      Serial.println("NEW MESSAGE DETECTED");
      Serial.println("START: 11111111");
      Serial.println("==========================================");
      Serial.println();


      // Move to character receiving mode.
      state = WAITING_FOR_DATA;


      // Wait for Sender's START period.
      delay(START_TIME + 100);

      return;
    }

    return;
  }


  // ==========================================================
  // STATE 2
  // WAITING FOR DATA
  // ==========================================================

  if (state == WAITING_FOR_DATA) {

    // 00000000 = gap/end
    if (value == 0x00) {

      return;
    }


    // Ignore START if received unexpectedly.
    if (value == 0xFF) {

      return;
    }


    // --------------------------------------------------------
    // Printable ASCII
    // --------------------------------------------------------

    if (value >= 32 && value <= 126) {

      char character = (char)value;


      // Add character to the current message.
      receivedWord += character;


      Serial.print("Character: ");
      Serial.print(character);

      Serial.print(" | ASCII: ");
      Serial.print(value);

      Serial.print(" | Binary: ");

      printBinary(value);

      Serial.println();


      // Wait for the character's display period.
      state = WAITING_FOR_GAP;

      delay(DATA_TIME + 100);

      return;
    }


    return;
  }


  // ==========================================================
  // STATE 3
  // WAITING FOR GAP
  // ==========================================================

  if (state == WAITING_FOR_GAP) {

    // Sender should now have all GPIO lines LOW.
    if (value == 0x00) {

      // Wait for the character gap.
      delay(GAP_TIME + 100);


      byte nextValue = readByte();


      // ------------------------------------------------------
      // If still LOW, the current message is finished.
      // ------------------------------------------------------

      if (nextValue == 0x00) {

        Serial.println();
        Serial.println("==========================================");
        Serial.println("MESSAGE COMPLETE");
        Serial.println("==========================================");

        Serial.print("RECEIVED WORD: ");
        Serial.println(receivedWord);

        Serial.println("==========================================");
        Serial.println();


        // IMPORTANT:
        //
        // Do NOT display the word again.
        //
        // Wait for a completely NEW START signal.
        state = WAITING_FOR_NEW_MESSAGE;


        return;
      }


      // ------------------------------------------------------
      // A new character has arrived.
      // ------------------------------------------------------

      if (nextValue >= 32 && nextValue <= 126) {

        char character = (char)nextValue;


        receivedWord += character;


        Serial.print("Character: ");
        Serial.print(character);

        Serial.print(" | ASCII: ");
        Serial.print(nextValue);

        Serial.print(" | Binary: ");

        printBinary(nextValue);

        Serial.println();


        state = WAITING_FOR_GAP;

        delay(DATA_TIME + 100);

        return;
      }


      return;
    }
  }


  // ==========================================================
  // STATE 4
  // WAITING FOR A NEW MESSAGE
  // ==========================================================

  if (state == WAITING_FOR_NEW_MESSAGE) {

    // --------------------------------------------------------
    // DO NOTHING until a new START signal arrives.
    //
    // This prevents the old message from being displayed
    // repeatedly.
    // --------------------------------------------------------

    if (value == 0xFF) {

      // A NEW message has started.

      receivedWord = "";


      Serial.println();
      Serial.println("==========================================");
      Serial.println("NEW MESSAGE DETECTED");
      Serial.println("==========================================");
      Serial.println();


      state = WAITING_FOR_DATA;


      // Wait for Sender's START period.
      delay(START_TIME + 100);


      return;
    }


    // Nothing else happens here.
    return;
  }
}
