// =====================================================
// LABORATORY 1
// ESP32 8-BIT ASCII PARALLEL DATA TRANSMISSION
// RECEIVER
// =====================================================

// Eight parallel input pins.
// Bit 0 -> GPIO 4
// Bit 1 -> GPIO 5
// Bit 2 -> GPIO 18
// Bit 3 -> GPIO 19
// Bit 4 -> GPIO 21
// Bit 5 -> GPIO 22
// Bit 6 -> GPIO 23
// Bit 7 -> GPIO 25

const int DATA_PINS[8] = {
  4, 5, 18, 19, 21, 22, 23, 25
};

// Special protocol values
const byte START_MARKER = 0xFF;
const byte END_MARKER   = 0x00;

// Stores the received word.
String receivedWord = "";

// -----------------------------------------------------
// Read the eight GPIO inputs and reconstruct
// the 8-bit binary value.
// -----------------------------------------------------
byte readByte() {

  byte value = 0;

  for (int bit = 0; bit < 8; bit++) {

    int bitValue = digitalRead(DATA_PINS[bit]);

    // Put the input bit into its correct position.
    value |= ((byte)bitValue << bit);
  }

  return value;
}

// -----------------------------------------------------
// Print an 8-bit value in binary.
// -----------------------------------------------------
void printBinary(byte value) {

  for (int bit = 7; bit >= 0; bit--) {
    Serial.print((value >> bit) & 0x01);
  }
}

// -----------------------------------------------------
// SETUP
// -----------------------------------------------------
void setup() {

  Serial.begin(115200);

  // Configure all eight GPIO pins as inputs.
  for (int bit = 0; bit < 8; bit++) {
    pinMode(DATA_PINS[bit], INPUT);
  }

  Serial.println();
  Serial.println("=================================");
  Serial.println("ESP32 ASCII PARALLEL RECEIVER");
  Serial.println("=================================");
  Serial.println("Waiting for transmission...");
  Serial.println();
}

// -----------------------------------------------------
// LOOP
// -----------------------------------------------------
void loop() {

  // Read the eight parallel data lines.
  byte value = readByte();

  // ---------------------------------------------------
  // WAIT FOR START MARKER
  // ---------------------------------------------------

  if (value == START_MARKER) {

    // Clear the previous word.
    receivedWord = "";

    Serial.println("START marker detected.");
    Serial.println("Receiving...");
    
    // Wait until the sender moves away from the
    // START marker before reading character data.
    delay(120);

    return;
  }

  // ---------------------------------------------------
  // END MARKER
  // ---------------------------------------------------

  if (value == END_MARKER) {

    // Only display the word if something was received.
    if (receivedWord.length() > 0) {

      Serial.println();
      Serial.println("=================================");
      Serial.print("RECEIVED WORD: ");
      Serial.println(receivedWord);
      Serial.println("=================================");
      Serial.println();
      Serial.println("Waiting for next transmission...");
      Serial.println();
    }

    // Wait until the sender moves away from
    // the END marker.
    delay(120);

    return;
  }

  // ---------------------------------------------------
  // PRINTABLE ASCII CHARACTER
  // ---------------------------------------------------

  // Printable ASCII characters normally range from
  // decimal 32 to 126.
  if (value >= 32 && value <= 126) {

    char character = (char)value;

    // Add the character to the received word.
    receivedWord += character;

    Serial.print("Received ASCII: ");
    Serial.print(value);

    Serial.print("   Binary: ");
    printBinary(value);

    Serial.print("   Character: ");
    Serial.println(character);

    // Wait for the sender to move to the next byte.
    delay(120);
  }
}
